{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hou-152/ai-native-helpdesk/schemas/public-card.schema.json",
  "title": "AI Native Helpdesk PublicCard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "card_id",
    "domain",
    "revision",
    "question",
    "aliases",
    "applies_to",
    "not_for",
    "answer",
    "next_action",
    "verification_steps",
    "public_sources",
    "supported_versions",
    "last_verified",
    "editorial",
    "verification",
    "privacy_gate",
    "publication"
  ],
  "properties": {
    "schema_version": {
      "const": "0.3"
    },
    "card_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "domain": {
      "const": "AI_AGENT_OPENCLAW"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "question": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "aliases": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      }
    },
    "applies_to": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "not_for": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 12000
    },
    "next_action": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "verification_steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "public_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "url", "checked_at"],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https://"
          },
          "checked_at": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "supported_versions": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "last_verified": {
      "type": "string",
      "format": "date"
    },
    "editorial": {
      "const": "APPROVED"
    },
    "verification": {
      "const": "PASS"
    },
    "privacy_gate": {
      "const": "PASS"
    },
    "publication": {
      "const": "READY"
    }
  }
}
