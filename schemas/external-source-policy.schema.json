{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hou-152/ai-native-helpdesk/schemas/external-source-policy.schema.json",
  "title": "AI Native Helpdesk external source policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "revision",
    "owner",
    "effective_at",
    "expires_at",
    "sources"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "policy_id": {
      "const": "AIHD-EXTERNAL-SOURCES"
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "effective_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "owner",
          "status",
          "allowed_risks",
          "url_prefixes",
          "stable_max_age_hours",
          "dynamic_max_age_hours",
          "invalidation_conditions"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "owner": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "status": {
            "enum": [
              "ACTIVE",
              "INACTIVE"
            ]
          },
          "allowed_risks": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "LOW",
                "MEDIUM",
                "HIGH"
              ]
            }
          },
          "url_prefixes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "stable_max_age_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8760
          },
          "dynamic_max_age_hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 168
          },
          "invalidation_conditions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 20,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240
            }
          }
        }
      }
    }
  }
}
