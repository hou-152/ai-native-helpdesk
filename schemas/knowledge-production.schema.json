{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hou-152/ai-native-helpdesk/schemas/knowledge-production.schema.json",
  "title": "AI Native Helpdesk Knowledge Production Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "source_lane",
    "candidate_authorization",
    "feedback_level",
    "answer_candidate_status",
    "human_distillation",
    "answer_status",
    "applicability_status",
    "next_action_status",
    "verification_method_status",
    "machine_structure",
    "human_qa",
    "editorial",
    "verification",
    "privacy_gate",
    "publication",
    "owner_publication_decision"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"
    },
    "source_lane": {
      "enum": ["ORDINARY_AUTHORIZED_CANDIDATE", "MISS_REVIEWED_ANSWER_CANDIDATE"]
    },
    "candidate_authorization": {
      "enum": ["APPROVED", "PENDING_G12", "HOLD"]
    },
    "feedback_level": {
      "enum": ["NOT_APPLICABLE", "MISS", "ACKNOWLEDGED", "ADOPTED", "OUTCOME_REPORTED"]
    },
    "answer_candidate_status": {
      "enum": ["NOT_APPLICABLE", "DRAFT", "APPROVED"]
    },
    "human_distillation": {
      "enum": ["NOT_APPLICABLE", "PENDING", "PASS"]
    },
    "answer_status": { "enum": ["READY", "MISSING"] },
    "applicability_status": { "enum": ["READY", "MISSING"] },
    "next_action_status": { "enum": ["READY", "MISSING"] },
    "verification_method_status": { "enum": ["READY", "MISSING"] },
    "machine_structure": { "enum": ["PASS", "FAIL"] },
    "human_qa": { "enum": ["PASS", "PENDING_G12", "FAIL"] },
    "editorial": { "enum": ["APPROVED", "HOLD"] },
    "verification": { "enum": ["PASS", "HOLD"] },
    "privacy_gate": { "enum": ["PASS", "HOLD"] },
    "publication": { "enum": ["READY", "HOLD"] },
    "owner_publication_decision": { "enum": ["APPROVED", "PENDING_G12", "DENIED"] }
  },
  "allOf": [
    {
      "if": {
        "properties": { "source_lane": { "const": "ORDINARY_AUTHORIZED_CANDIDATE" } }
      },
      "then": {
        "properties": {
          "feedback_level": { "const": "NOT_APPLICABLE" },
          "answer_candidate_status": { "const": "NOT_APPLICABLE" },
          "human_distillation": { "const": "NOT_APPLICABLE" }
        }
      }
    },
    {
      "if": {
        "properties": { "source_lane": { "const": "MISS_REVIEWED_ANSWER_CANDIDATE" } }
      },
      "then": {
        "properties": {
          "feedback_level": { "enum": ["ADOPTED", "OUTCOME_REPORTED"] },
          "answer_candidate_status": { "const": "APPROVED" },
          "human_distillation": { "const": "PASS" }
        }
      }
    }
  ]
}
