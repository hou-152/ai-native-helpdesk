{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hou-152/ai-native-helpdesk/schemas/psych-label-consent.schema.json",
  "title": "AI Native psych-label purpose-scoped consent decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["consent"],
  "properties": {
    "consent": { "$ref": "#/$defs/consentReceipt" },
    "follow_up_at": { "type": "string", "format": "date-time" },
    "follow_up_days": { "const": 7 },
    "now": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "opaqueReference": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "consentReceipt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "receipt_ref", "granted_at", "expires_at", "revoked_at", "scopes"],
      "properties": {
        "decision": { "const": "GRANTED" },
        "receipt_ref": { "$ref": "#/$defs/opaqueReference" },
        "granted_at": { "type": "string", "format": "date-time" },
        "expires_at": { "type": "string", "format": "date-time" },
        "revoked_at": {
          "oneOf": [
            { "type": "null" },
            { "type": "string", "format": "date-time" }
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["FEEDBACK_PERSISTENCE", "SEVEN_DAY_FOLLOW_UP"]
          }
        }
      }
    }
  }
}
