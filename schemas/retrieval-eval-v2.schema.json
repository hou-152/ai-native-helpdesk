{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/hou-152/ai-native-helpdesk/schemas/retrieval-eval-v2.schema.json",
  "title": "AI Native Helpdesk Retrieval Holdout v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "dataset_id", "generation", "cases"],
  "properties": {
    "schema_version": { "const": "2.0" },
    "dataset_id": { "const": "aihd-retrieval-holdout-v2" },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "implementation_commit", "spec_sha256", "seed_sha256"],
      "properties": {
        "namespace": { "const": "AIHD_PHASE1_V2_HOLDOUT_2026-08-18" },
        "implementation_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "seed_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "split",
          "query",
          "expected_status",
          "expected_candidates",
          "risk_class",
          "precondition",
          "provenance",
          "rationale",
          "tags"
        ],
        "properties": {
          "case_id": { "type": "string", "pattern": "^RET-V2-B-[0-9]{3}$" },
          "split": { "const": "HOLDOUT" },
          "query": { "type": "string", "minLength": 1, "maxLength": 500 },
          "expected_status": { "enum": ["CANDIDATE", "CLARIFY", "MISS", "DENY"] },
          "expected_candidates": {
            "type": "array",
            "maxItems": 3,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^FIX-[A-Z0-9-]+$" }
          },
          "risk_class": { "enum": ["LOW", "MEDIUM", "HIGH"] },
          "precondition": {
            "enum": ["ELIGIBLE", "DENY_PRIVACY", "DENY_INJECTION", "DENY_INDEX_DRIFT"]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source_ref", "privacy"],
            "properties": {
              "kind": { "const": "synthetic_fixture" },
              "source_ref": { "type": "string", "minLength": 1, "maxLength": 300 },
              "privacy": { "const": "public_safe" }
            }
          },
          "rationale": { "type": "string", "minLength": 1, "maxLength": 500 },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9_-]+$" }
          }
        }
      }
    }
  }
}
